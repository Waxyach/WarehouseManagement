<Application x:Class="WarehouseManagementApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WarehouseManagementApp"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:WarehouseManagementApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:DocumentTypeToStringConverter x:Key="DocTypeConverter" />
            
        </ResourceDictionary>
    </Application.Resources>
</Application>