<ui:FluentWindow x:Class="WarehouseManagementApp.Views.UnitsManagementWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Керування одиницями виміру" 
                 Height="540" Width="520" 
                 MinHeight="480" MinWidth="460"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Керування одиницями виміру" />

        <Border Grid.Row="2" Margin="24,0,24,14" Background="#F9FAFB" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
            <ListBox x:Name="UnitsListBox" 
                     ItemsSource="{Binding Units}"
                     SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                     Background="Transparent" 
                     BorderThickness="0" 
                     Padding="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" 
                                  Command="{Binding EditUnitCommand}" 
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E0F2FE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="26" CornerRadius="5" Background="#E0F2FE" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Code}" FontSize="12" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="#9CA3AF">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Цілочисельна"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFractional}" Value="True">
                                                <Setter Property="Text" Value="Дробова (кг, л)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="24,0,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="Додати" 
                           Icon="{ui:SymbolIcon Add20}" 
                           Appearance="Primary" 
                           Height="36" Padding="14,0"
                           Command="{Binding AddUnitCommand}"
                           CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="0,0,8,0"/>

                <ui:Button Content="Редагувати" 
                           Icon="{ui:SymbolIcon Edit20}" 
                           Height="36" Padding="14,0"
                           Command="{Binding EditUnitCommand}"
                           CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="0,0,8,0"/>

                <ui:Button Content="Видалити" 
                           Icon="{ui:SymbolIcon Delete20}" 
                           Appearance="Danger" 
                           Height="36" Padding="12,0"
                           Command="{Binding DeleteUnitCommand}"/>
            </StackPanel>

            <ui:Button Grid.Column="1" 
                       Content="Закрити" 
                       Height="36" Width="90" 
                       Command="{Binding CloseCommand}"
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" 
                              Grid.Row="0" 
                              Grid.RowSpan="4"
                              Panel.ZIndex="999"
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch" />
    </Grid>
</ui:FluentWindow>