<ui:FluentWindow x:Class="WarehouseManagementApp.Views.DocumentDetailsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:converters="clr-namespace:WarehouseManagementApp.Converters"
                 Title="Перегляд накладної" 
                 Height="600" Width="880" 
                 MinHeight="500" MinWidth="720"
                 WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:DocumentTypeToStringConverter x:Key="DocTypeConverter"/>

        <Style x:Key="FlatColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Document.DocumentNumber, StringFormat='Документ: {0}'}" />

        <ui:Card Grid.Row="1" Margin="16,8,16,10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,8">
                    <TextBlock Text="Тип документа:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Document.Type, Converter={StaticResource DocTypeConverter}}" FontWeight="Bold" FontSize="14" Foreground="#1F2937"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,8">
                    <TextBlock Text="Номер накладної:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Document.DocumentNumber}" FontWeight="Bold" FontSize="14" Foreground="#2563EB"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Дата і час:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Document.Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,10,0">
                    <TextBlock Text="Отримувач:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Document.Counterparty}" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <TextBlock Text="Примітка:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Document.Note, TargetNullValue='—'}" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Document.Items}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  CanUserAddRows="False" 
                  HeadersVisibility="Column" 
                  GridLinesVisibility="Horizontal" 
                  HorizontalGridLinesBrush="#E5E7EB" 
                  BorderThickness="0" 
                  Background="Transparent" 
                  RowHeight="36" 
                  ColumnHeaderHeight="34" 
                  FontSize="13" 
                  ColumnHeaderStyle="{StaticResource FlatColumnHeaderStyle}" 
                  CellStyle="{StaticResource FlatDataGridCellStyle}" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="16,0,16,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Product.Sku}" Width="130" FontWeight="Bold"/>
                <DataGridTextColumn Header="Назва товару" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="110"/>
                <DataGridTextColumn Header="Од. вим." Binding="{Binding Product.Unit.Code}" Width="85"/>
                <DataGridTextColumn Header="Ціна (грн)" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="130"/>
                <DataGridTextColumn Header="Сума (грн)" Binding="{Binding TotalPrice, StringFormat={}{0:N2}}" Width="140" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#FFFFFF" Padding="20,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Загальна сума: " FontSize="14" VerticalAlignment="Center"/>
                    <Border BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="6,0,0,0">
                        <TextBlock Text="{Binding Document.TotalAmount, StringFormat='{}{0:N2} грн'}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <ui:Button Grid.Column="1" 
                           Content="Закрити" 
                           Width="100" Height="36" 
                           Command="{Binding CloseCommand}"
                           CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" 
                              Grid.Row="0" 
                              Grid.RowSpan="4" 
                              Panel.ZIndex="999" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"/>
    </Grid>
</ui:FluentWindow>