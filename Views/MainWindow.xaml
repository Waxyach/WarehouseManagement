<ui:FluentWindow x:Class="WarehouseManagementApp.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:WarehouseManagementApp.Views"
                 Title="Склад"
                 Width="1150" Height="750"
                 MinWidth="900" MinHeight="550"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Склад">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="10,0,10,10">
            <TabItem Header="Залишки">
                <views:ProductsView DataContext="{Binding ProductsVm}"/>
            </TabItem>
            <TabItem Header="Документи">
                <views:DocumentsView DataContext="{Binding DocumentsVm}"/>
            </TabItem>
        </TabControl>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" 
                              Grid.Row="0" 
                              Grid.RowSpan="2" 
                              Panel.ZIndex="999" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"/>
    </Grid>
</ui:FluentWindow>