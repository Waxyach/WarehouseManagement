<ui:FluentWindow x:Class="WarehouseManagementApp.Views.CategoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title}" 
                 Height="520" Width="440" 
                 MinHeight="460" MinWidth="460"
                 WindowStartupLocation="CenterOwner" 
                 ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="{Binding Title}" />

        <Border Grid.Row="1" Margin="20,12,20,12" Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
            <StackPanel>
                <TextBlock Text="Назва категорії:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="NameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12" Background="#FFFFFF"/>

                <TextBlock Text="Вибір кольору:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="140" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" ClipToBounds="True">
                        <Canvas x:Name="SatValCanvas" Background="Transparent"
                                MouseDown="SatValCanvas_MouseDown" MouseMove="SatValCanvas_MouseMove" MouseUp="SatValCanvas_MouseUp" Cursor="Cross">
                            <Rectangle x:Name="HueBackgroundRect"
                                       Width="{Binding ActualWidth, ElementName=SatValCanvas}"
                                       Height="{Binding ActualHeight, ElementName=SatValCanvas}"
                                       Fill="#FF0000"/>
                            <Rectangle Width="{Binding ActualWidth, ElementName=SatValCanvas}"
                                       Height="{Binding ActualHeight, ElementName=SatValCanvas}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Width="{Binding ActualWidth, ElementName=SatValCanvas}"
                                       Height="{Binding ActualHeight, ElementName=SatValCanvas}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#FF000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Ellipse x:Name="PickerThumb" Width="12" Height="12" 
                                     Stroke="White" StrokeThickness="2" Fill="Transparent" 
                                     IsHitTestVisible="False" Canvas.Left="50" Canvas.Top="50">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Border>

                    <Border Grid.Column="2" Height="140" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" ClipToBounds="True">
                        <Canvas x:Name="HueCanvas" Background="Transparent"
                                MouseDown="HueCanvas_MouseDown" MouseMove="HueCanvas_MouseMove" MouseUp="HueCanvas_MouseUp" Cursor="Hand">
                            <Rectangle Width="{Binding ActualWidth, ElementName=HueCanvas}"
                                       Height="{Binding ActualHeight, ElementName=HueCanvas}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.17"/>
                                        <GradientStop Color="#00FF00" Offset="0.33"/>
                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="0.67"/>
                                        <GradientStop Color="#FF00FF" Offset="0.83"/>
                                        <GradientStop Color="#FF0000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border x:Name="HueThumb" Width="28" Height="4" Background="#111827" BorderBrush="White" BorderThickness="1" CornerRadius="1" IsHitTestVisible="False" Canvas.Top="0"/>
                        </Canvas>
                    </Border>

                    <Border Grid.Column="4" Height="140" CornerRadius="6" 
                            x:Name="PreviewColorBox" 
                            Background="{Binding ColorHex, FallbackValue='#71717A'}" 
                            BorderBrush="#D1D5DB" BorderThickness="1"/>
                </Grid>

                <TextBlock Text="Стандартні кольори:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="22" Height="22" CornerRadius="11" Background="#EF4444" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#EF4444"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#F97316" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#F97316"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#F59E0B" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#F59E0B"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#10B981" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#10B981"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#06B6D4" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#06B6D4"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#3B82F6" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#3B82F6"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#8B5CF6" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#8B5CF6"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#EC4899" Margin="0,0,6,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPresetColorCommand}" CommandParameter="#EC4899"/>
                        </Border.InputBindings>
                    </Border>
                </StackPanel>

                <TextBlock Text="Нещодавні кольори:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,5" 
                           Visibility="{Binding HasRecentColors, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding RecentColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="22" Height="22" CornerRadius="11" 
                                    Background="{Binding}" 
                                    Margin="0,0,6,6" 
                                    Cursor="Hand" 
                                    BorderBrush="#E5E7EB" BorderThickness="1">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" 
                                                  Command="{Binding DataContext.SelectPresetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <ui:Button Content="Зберегти" Appearance="Primary" Height="34" Padding="20,0" 
                       Command="{Binding SaveCommand}" 
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                       Margin="0,0,8,0"/>
            <ui:Button Content="Скасувати" Height="34" Padding="16,0" 
                       Command="{Binding CancelCommand}" 
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</ui:FluentWindow>