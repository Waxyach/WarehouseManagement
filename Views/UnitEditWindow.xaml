<ui:FluentWindow x:Class="WarehouseManagementApp.Views.UnitEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title}" 
                 Height="360" Width="440" 
                 WindowStartupLocation="CenterOwner" 
                 ResizeMode="NoResize">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <Border Grid.Row="1" Margin="20,12,20,12" Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
            <StackPanel>
                <TextBlock Text="Повна назва:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                            Height="34" Margin="0,0,0,12" Background="#FFFFFF" PlaceholderText="Кілограм, Штука..."/>

                <TextBlock Text="Символ:" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" 
                            Height="34" Margin="0,0,14,0" Background="#FFFFFF" PlaceholderText="кг, шт, л..."/>

                <CheckBox IsChecked="{Binding IsFractional, Mode=TwoWay}" 
                          Content="Дозволити дробові значення" 
                          FontWeight="SemiBold" FontSize="12" Margin="0,6,0,2"/>
                <TextBlock Text="Увімкніть, якщо кількість товару може бути дробова" 
                           FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <ui:Button Content="Зберегти" Appearance="Primary" Height="34" Padding="20,0" 
                       Command="{Binding SaveCommand}" 
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                       Margin="0,0,8,0"/>
            <ui:Button Content="Скасувати" Height="34" Padding="16,0" 
                       Command="{Binding CancelCommand}" 
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" 
                              Grid.Row="0" 
                              Grid.RowSpan="3" 
                              Panel.ZIndex="999" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"/>
    </Grid>
</ui:FluentWindow>