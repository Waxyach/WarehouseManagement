<ui:FluentWindow x:Class="WarehouseManagementApp.Views.CreateDocumentWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:converters="clr-namespace:WarehouseManagementApp.Converters"
                 Title="Створення складського документа"
                 Height="740" Width="980"
                 MinHeight="620" MinWidth="840"
                 WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:DocumentTypeToStringConverter x:Key="DocTypeConverter"/>

        <Style x:Key="FlatColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Створення складського документа"/>

        <StackPanel Grid.Row="1" Margin="16,8,16,10">

            <ui:Card Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Основні реквізити" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Тип документа" FontSize="11" Foreground="#6B7280" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DocumentTypes}"
                                      SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                      Height="36" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DocTypeConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Номер накладної" FontSize="11" Foreground="#6B7280" Margin="2,0,0,4"/>
                            <ui:TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                                        Icon="{ui:SymbolIcon Document20}"
                                        Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Отримувач" FontSize="11" Foreground="#6B7280" Margin="2,0,0,4"/>
                            <ui:TextBox Text="{Binding Counterparty, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Постачальник або покупець..."
                                        Icon="{ui:SymbolIcon Person20}"
                                        ClearButtonEnabled="True"
                                        Height="36"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Примітка" FontSize="11" Foreground="#6B7280" Margin="2,0,0,4"/>
                        <ui:TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Додатковий коментар до документа..."
                                    Icon="{ui:SymbolIcon Note20}"
                                    ClearButtonEnabled="True"
                                    Height="36"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="14">
                <StackPanel>
                    <TextBlock Text="Додавання товару" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Оберіть товар зі списку" FontSize="11" Foreground="#6B7280" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableProducts}"
                                      SelectedItem="{Binding SelectedProductToAdd}"
                                      DisplayMemberPath="Name"
                                      Height="36" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Grid Margin="2,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Кількість" FontSize="11" Foreground="#6B7280"/>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding StockHintText}" 
                                           FontSize="10" 
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#0284C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQuantityExceeded}" Value="True">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStockLimitActive}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border CornerRadius="6" Height="36">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuantityExceeded}" Value="True">
                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="#FEF2F2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:Button Grid.Column="0" 
                                               Icon="{ui:SymbolIcon Subtract16}" 
                                               Appearance="Transparent" 
                                               Padding="0" 
                                               Width="32" Height="32" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Command="{Binding DecreaseQuantityCommand}"
                                               ToolTip="Зменшити"/>

                                    <TextBox Grid.Column="1" 
                                             Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}"
                                             TextAlignment="Center" 
                                             VerticalContentAlignment="Center"
                                             BorderThickness="0" 
                                             Background="Transparent"
                                             FontWeight="Bold"
                                             FontSize="13">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQuantityExceeded}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <ui:Button Grid.Column="2" 
                                               Icon="{ui:SymbolIcon Add16}" 
                                               Appearance="Transparent" 
                                               Padding="0" 
                                               Width="32" Height="32" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Command="{Binding IncreaseQuantityCommand}"
                                               IsEnabled="{Binding CanIncreaseQuantity}"
                                               ToolTip="Збільшити"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Ціна (грн)" FontSize="11" Foreground="#6B7280" Margin="2,0,0,4"/>
                            <ui:TextBox Text="{Binding PriceToAdd, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="0.00"
                                        Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <ui:Button Content="Додати рядок"
                                       Icon="{ui:SymbolIcon Add20}"
                                       Appearance="Primary"
                                       Command="{Binding AddItemCommand}"
                                       Height="36" Padding="14,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <Border Grid.Row="2" 
                Background="#FFFFFF" 
                BorderBrush="#E5E7EB" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="16,0,16,10">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="38"
                      ColumnHeaderHeight="36"
                      FontSize="13"
                      ColumnHeaderStyle="{StaticResource FlatColumnHeaderStyle}"
                      CellStyle="{StaticResource FlatDataGridCellStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Product.Sku}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Назва товару" Binding="{Binding Product.Name}" Width="*"/>
                    <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="110" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Од. вим." Binding="{Binding Product.Unit.Code}" Width="85"/>
                    <DataGridTextColumn Header="Ціна (грн)" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="Сума (грн)" Binding="{Binding TotalPrice, StringFormat={}{0:N2}}" Width="140" FontWeight="Bold"/>

                    <DataGridTemplateColumn Width="48" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FlatColumnHeaderStyle}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Icon="{ui:SymbolIcon Delete20}"
                                           Appearance="Transparent"
                                           Foreground="#DC2626"
                                           Padding="4"
                                           Width="30" Height="30"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           ToolTip="Видалити рядок"
                                           Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Загальна сума: " FontSize="14" VerticalAlignment="Center"/>
                    <Border BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="6,0,0,0">
                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} грн'}" 
                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Скасувати" 
                               Width="110" Height="36" 
                               Command="{Binding CancelCommand}"
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                               Margin="0,0,10,0"/>

                    <ui:Button Content="Провести накладну" 
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Appearance="Success"
                               Width="180" Height="36"
                               Command="{Binding ProcessDocumentCommand}"
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" 
                              Grid.Row="0" 
                              Grid.RowSpan="4"
                              Panel.ZIndex="999"
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"/>
    </Grid>
</ui:FluentWindow>