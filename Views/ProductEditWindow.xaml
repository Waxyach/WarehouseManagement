<ui:FluentWindow x:Class="WarehouseManagementApp.Views.EditProductWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:converters="clr-namespace:WarehouseManagementApp.Converters"
                  Title="Редагування товару"
                  Height="640" Width="520"
                  WindowStartupLocation="CenterOwner"
                  ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Редагування товару"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,12,22,16">

                <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Артикул (SKU)" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock Text="{Binding Sku}" FontSize="14" FontWeight="Bold" Foreground="#1F2937" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Box20" Foreground="#0284C7" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StockBalanceDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Margin="0,0,0,12">
                    <Grid Margin="2,0,0,4">
                        <TextBlock Text="Назва товару" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                        <TextBlock Text="🔒 Заблоковано"
                                   FontSize="11"
                                   Foreground="#DC2626"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding IsUsedInDocuments, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                    <ui:TextBox x:Name="NameTextBox"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="{Binding IsUsedInDocuments}"
                                PlaceholderText="Введіть назву товару..."
                                Height="36">
                        <ui:TextBox.Style>
                            <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsedInDocuments}" Value="True">
                                        <Setter Property="Background" Value="#F3F4F6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBox.Style>
                    </ui:TextBox>

                    <Border Background="#FEF3C7"
                            BorderBrush="#FDE68A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,6,0,0"
                            Visibility="{Binding IsUsedInDocuments, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="LockClosed16" Foreground="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Редагування назви заблоковано: товар уже фігурує в накладних."
                                       FontSize="11"
                                       Foreground="#92400E"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Категорія товару" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="2,0,0,4"/>
                        <ComboBox x:Name="CategoryComboBox"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name"
                                  Height="36"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Одиниця виміру" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="2,0,0,4"/>
                        <ComboBox x:Name="UnitComboBox"
                                  ItemsSource="{Binding CompatibleUnits}"
                                  SelectedItem="{Binding SelectedUnit}"
                                  Height="36"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Null}, StringFormat='{}{0}'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding UnitCategoryNotice}" FontSize="10" Foreground="#6B7280" Margin="2,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info16" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Закупівельна ціна (грн)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="2,0,0,4"/>
                        <ui:TextBox x:Name="PurchasePriceTextBox"
                                    Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}"
                                    Height="36"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Роздрібна ціна (грн)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="2,0,0,4"/>
                        <ui:TextBox x:Name="RetailPriceTextBox"
                                    Text="{Binding RetailPriceText, UpdateSourceTrigger=PropertyChanged}"
                                    Height="36"/>
                    </StackPanel>
                </Grid>

 
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Мінімальний поріг залишку" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="2,0,0,4"/>
                    <ui:TextBox x:Name="MinQuantityTextBox"
                                Text="{Binding MinQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                Height="36"/>
                    <TextBlock Text="При залишку нижче або рівному цьому значенню товар вважається дефіцитним" FontSize="11" Foreground="#6B7280" Margin="2,4,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        
        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Скасувати"
                           Command="{Binding CancelCommand}"
                           CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="0,0,10,0" Width="100" Height="36"/>
                <ui:Button Content="Зберегти зміни"
                           Appearance="Primary"
                           Command="{Binding SaveCommand}"
                           CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="140" Height="36"/>
            </StackPanel>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="3" Panel.ZIndex="999"/>
    </Grid>
</ui:FluentWindow>