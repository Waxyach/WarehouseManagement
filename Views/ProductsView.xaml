<UserControl x:Class="WarehouseManagementApp.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:WarehouseManagementApp.Converters">
    <UserControl.Resources>
        <converters:LowStockToBrushConverter x:Key="LowStockToBrushConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style x:Key="DeficitToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonViewToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonSepStyle" TargetType="Separator">
            <Setter Property="Margin" Value="8,6"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="FlatColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,6,12,6">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">

                    <Border BorderBrush="Transparent" Padding="4,0,4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding CreateProductCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="AddCircle24" FontSize="22" Foreground="#16A34A" Margin="0,0,0,2"/>
                                        <TextBlock Text="Новий товар" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding EditProductCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Edit24" FontSize="22" Foreground="#2563EB" Margin="0,0,0,2"/>
                                        <TextBlock Text="Редагувати" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Товари" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource RibbonSepStyle}"/>

                    <Border BorderBrush="Transparent" Padding="4,0,4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding OpenCategoriesCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Tag24" FontSize="22" Foreground="#2563EB" Margin="0,0,0,2"/>
                                        <TextBlock Text="Категорії" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding OpenUnitsCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Ruler24" FontSize="22" Foreground="#2563EB" Margin="0,0,0,2"/>
                                        <TextBlock Text="Одиниці" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Довідники" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource RibbonSepStyle}"/>
                    
                    <Border BorderBrush="Transparent" Padding="4,0,4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                            PlaceholderText="Пошук..."
                                            Icon="{ui:SymbolIcon Search20}"
                                            ClearButtonEnabled="True"
                                            Width="180" Height="34" Margin="2,0,6,0"/>

                                <ComboBox ItemsSource="{Binding Categories}" 
                                          SelectedItem="{Binding SelectedCategoryFilter}"
                                          DisplayMemberPath="Name"
                                          Width="160" Height="34" Margin="2,0,6,0"/>

                                <ToggleButton Style="{StaticResource DeficitToggleButtonStyle}"
                                              IsChecked="{Binding OnlyLowStock}"
                                              Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Warning20" Foreground="#DC2626" Margin="0,0,6,0"/>
                                        <TextBlock Text="Дефіцит" FontSize="12" FontWeight="SemiBold" Foreground="#991B1B"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Фільтрація" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource RibbonSepStyle}"/>
                    
                    <Border BorderBrush="Transparent" Padding="4,0,4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource RibbonViewToggleStyle}"
                                             GroupName="ViewModesGroup"
                                             IsChecked="{Binding IsFolderView, Converter={StaticResource InverseBooleanConverter}}"
                                             Command="{Binding SetTableViewCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Table24" FontSize="20" Foreground="#2563EB" Margin="0,0,0,2"/>
                                        <TextBlock Text="Таблиця" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource RibbonViewToggleStyle}"
                                             GroupName="ViewModesGroup"
                                             IsChecked="{Binding IsFolderView}"
                                             Command="{Binding SetFolderViewCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="20" Foreground="#D97706" Margin="0,0,0,2"/>
                                        <TextBlock Text="Категорії" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Вигляд" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource RibbonSepStyle}"/>
                    
                    <Border BorderBrush="Transparent" Padding="4,0,4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding ExportToExcelCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DocumentTable24" FontSize="22" Foreground="#16A34A" Margin="0,0,0,2"/>
                                        <TextBlock Text="Звіт Excel" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding DeleteProductCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="22" Foreground="#DC2626" Margin="0,0,0,2"/>
                                        <TextBlock Text="Видалити" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Операції" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <DataGrid Grid.Row="1" 
                  x:Name="ProductsGrid"
                  ItemsSource="{Binding Products}" 
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5E7EB"
                  BorderThickness="0"
                  Background="Transparent"
                  RowHeight="38"
                  ColumnHeaderHeight="36"
                  FontSize="13"
                  ColumnHeaderStyle="{StaticResource FlatColumnHeaderStyle}"
                  CellStyle="{StaticResource FlatDataGridCellStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="12,10,12,0">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" 
                              Command="{Binding EditProductCommand}" 
                              CommandParameter="{Binding SelectedProduct}"/>
            </DataGrid.InputBindings>
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFolderView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource LowStockToBrushConverter}">
                                <Binding Path="StockBalance.CurrentQuantity"/>
                                <Binding Path="MinQuantity"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Колір" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="14" Height="14" CornerRadius="7" 
                                    Background="{Binding Category.ColorHex, FallbackValue='#CBD5E1'}" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="130" FontWeight="Bold"/>
                <DataGridTextColumn Header="Назва товару" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категорія" Binding="{Binding Category.Name}" Width="180"/>
                <DataGridTextColumn Header="Од." Binding="{Binding Unit.Code}" Width="65"/>
                <DataGridTextColumn Header="Залишок" Binding="{Binding StockBalance.CurrentQuantity, StringFormat={}{0:0.###}}" FontWeight="Bold" Width="110"/>
                <DataGridTextColumn Header="Поріг" Binding="{Binding MinQuantity, StringFormat={}{0:0.###}}" Width="80"/>
                <DataGridTextColumn Header="Закупівельна" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="130"/>
                <DataGridTextColumn Header="Роздрібна" Binding="{Binding RetailPrice, StringFormat={}{0:N2}}" Width="130" FontWeight="SemiBold"/>
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled" 
                      Margin="12,10,12,0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFolderView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <ItemsControl ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14" Height="14" CornerRadius="4" Background="{Binding Category.ColorHex}" Margin="0,0,8,0"/>
                                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" Foreground="{Binding Category.ColorHex}"/>
                                    <TextBlock Text="{Binding Category.Name}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Products.Count, StringFormat=' ({0} поз.)'}" Foreground="#6B7280" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <DataGrid ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding DataContext.SelectedProduct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E5E7EB"
                                      BorderThickness="0"
                                      RowHeight="36"
                                      ColumnHeaderHeight="34"
                                      FontSize="13"
                                      ColumnHeaderStyle="{StaticResource FlatColumnHeaderStyle}"
                                      CellStyle="{StaticResource FlatDataGridCellStyle}"
                                      Margin="8,4,8,8">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" 
                                                  Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectedItem}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="120" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Назва товару" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Одиниця" Binding="{Binding Unit.Code}" Width="80"/>
                                    <DataGridTextColumn Header="Залишок" Binding="{Binding StockBalance.CurrentQuantity, StringFormat={}{0:0.###}}" FontWeight="Bold" Width="100"/>
                                    <DataGridTextColumn Header="Поріг" Binding="{Binding MinQuantity, StringFormat={}{0:0.###}}" Width="80"/>
                                    <DataGridTextColumn Header="Ціна (грн)" Binding="{Binding RetailPrice, StringFormat={}{0:N2}}" Width="120" FontWeight="SemiBold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,6">
            <ui:TextBlock Appearance="Secondary" FontSize="12"
                          Text="{Binding Products.Count, StringFormat='Всього позицій на складі: {0}'}"/>
        </Border>
    </Grid>
</UserControl>